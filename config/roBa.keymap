#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// roBa Mac向け配列
// レイヤー: 0 ベース / 1 数字 / 2 矢印 / 3 記号 / 4 マウス(自動) / 5 スクロール / 6 システム

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        // 0: ベース
        // 親指（左から）: 英数/⌘  スペース/数字  かな/矢印 | BS  Enter/記号   右下: Del/システム
        // 左下: Ctrl  Opt  F18(Typeless用)
        default_layer {
            display-name = "Base";
            bindings = <
&kp Q             &kp W     &kp E     &kp R            &kp T                                          &kp Y      &kp U  &lt 5 I    &kp O    &kp P
&kp A             &kp S     &kp D     &kp F            &kp G         &none                &kp MINUS   &kp H      &kp J  &kp K      &kp L    &kp SQT
&mt LSHFT Z       &kp X     &kp C     &kp V            &kp B         &kp TAB              &kp SEMI    &kp N      &kp M  &kp COMMA  &kp DOT  &mt RSHFT SLASH
&kp LCTRL         &kp LALT  &kp F18   &mt LGUI LANG2   &lt 1 SPACE   &lt 2 LANG1          &kp BSPC    &lt 3 ENTER                           &lt 6 DEL
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };

        // 1: 数字（スペース長押し）  左手=数字 / 右手=F1〜F12
        NUM {
            display-name = "Num";
            bindings = <
&trans     &kp N7  &kp N8  &kp N9  &kp N0                              &trans  &kp F7  &kp F8  &kp F9  &kp F12
&kp MINUS  &kp N4  &kp N5  &kp N6  &kp PLUS   &trans          &trans   &trans  &kp F4  &kp F5  &kp F6  &kp F11
&kp N0     &kp N1  &kp N2  &kp N3  &kp EQUAL  &kp DOT         &trans   &trans  &kp F1  &kp F2  &kp F3  &kp F10
&trans     &trans  &trans  &trans  &trans     &trans          &trans   &trans                          &trans
            >;
        };

        // 2: 矢印（かな長押し）  逆T字の矢印 / 行頭・行末=⌘←→ / 単語移動=⌥←→
        ARROW {
            display-name = "Arrow";
            bindings = <
&kp ESC       &kp LC(LS(TAB))  &kp UP    &kp LC(TAB)   &trans                              &trans  &trans  &trans  &trans  &trans
&kp LG(LEFT)  &kp LEFT         &kp DOWN  &kp RIGHT     &kp LG(RIGHT)  &trans       &trans  &trans  &trans  &trans  &trans  &trans
&kp LSHFT     &kp LA(LEFT)     &trans    &kp LA(RIGHT) &trans         &trans       &trans  &trans  &trans  &trans  &trans  &kp RSHFT
&trans        &trans           &trans    &trans        &trans         &trans       &kp DEL &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(LS(TAB)) LC(TAB)>;
        };

        // 3: 記号（Enter長押し）  左手=数字レイヤーの同じ位置+Shift / 右手=かっこ
        SYM {
            display-name = "Sym";
            bindings = <
&trans     &kp AMPS  &kp STAR   &kp LPAR   &kp RPAR                          &trans  &kp LBKT  &kp RBKT  &trans    &trans
&kp GRAVE  &kp DLLR  &kp PRCNT  &kp CARET  &kp PLUS   &trans         &trans  &trans  &kp LPAR  &kp RPAR  &kp BSLH  &trans
&kp TILDE  &kp EXCL  &kp AT     &kp HASH   &kp EQUAL  &trans         &trans  &trans  &kp LBRC  &kp RBRC  &kp PIPE  &trans
&trans     &trans    &trans     &trans     &trans     &trans         &trans  &trans                                &trans
            >;
        };

        // 4: マウス（ボールを動かすと自動）
        MOUSE {
            display-name = "Mouse";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        // 5: スクロール（I長押し＋ボール）
        SCROLL {
            display-name = "Scroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        // 6: システム（Del長押し）  BT切替・リセット・書き込みモード
        SYSTEM {
            display-name = "System";
            bindings = <
&bt BT_SEL 0      &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                     &trans  &trans  &trans  &trans  &trans
&bt BT_CLR        &trans        &trans        &trans        &bootloader   &trans       &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_CLR_ALL    &trans        &trans        &trans        &trans        &trans  &bootloader  &trans  &trans  &trans  &trans  &trans
&trans            &trans        &trans        &trans        &trans        &trans       &trans  &trans                          &trans
            >;
        };
    };
};
